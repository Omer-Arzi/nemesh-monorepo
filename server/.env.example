# Server
HOST=0.0.0.0
PORT=1337

# Secrets (generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))")
APP_KEYS="toBeModified1,toBeModified2,toBeModified3,toBeModified4"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
ENCRYPTION_KEY=tobemodified

# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_FILENAME=
JWT_SECRET=tobemodified

# Script
ENABLE_RECIPE_IMPORT=true
STRAPI_URL=http://localhost:1337
STRAPI_IMPORT_TOKEN=

# ─── Production only (Railway + S3) ──────────────────────────────────────────
# NODE_ENV=production
# DATABASE_URL=postgresql://user:password@host:port/dbname
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# AWS_ACCESS_KEY_ID=
# AWS_ACCESS_SECRET=
# AWS_REGION=
# AWS_BUCKET=
# AWS_BUCKET_URL=https://<bucket>.s3.<region>.amazonaws.com
# AWS_ACL=                 # leave unset if bucket ACLs are disabled (Bucket owner enforced)
#                          # set to public-read only if bucket ACLs are explicitly enabled

# ─── CORS ────────────────────────────────────────────────────────────────────
# CLIENT_URL: legacy single-origin (kept for backward compatibility)
# CLIENT_URL=https://your-nextjs-app.vercel.app

# CLIENT_URLS: comma-separated exact origins (use this for production + staging)
# CLIENT_URLS=https://nemesh-client.vercel.app,https://www.example.com

# VERCEL_PREVIEW_ORIGIN_PATTERNS: comma-separated regex patterns anchored to the full origin.
# Use to allow Vercel preview URLs without opening *.vercel.app to all projects.
# Single backslash in the file — Node.js reads it as a literal backslash in the regex.
# VERCEL_PREVIEW_ORIGIN_PATTERNS=^https://nemesh-client-[a-z0-9-]+-omer-arzis-projects\.vercel\.app$,^https://nemesh-client-[a-z0-9-]+\.vercel\.app$
