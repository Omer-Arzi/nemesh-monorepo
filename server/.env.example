# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# ─── Secrets (generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))")
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_CLIENT=postgres

# Option A — connection string (preferred for Railway; overrides individual fields below).
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Option B — individual fields (for local dev without a connection string).
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false
# Set these when DATABASE_SSL=true and you need cert-level control:
# DATABASE_SSL_REJECT_UNAUTHORIZED=false   # required for Railway / cloud PG (self-signed certs)
# DATABASE_SSL_KEY=
# DATABASE_SSL_CERT=
# DATABASE_SSL_CA=

# ─── AWS S3 (production uploads only — not needed in development) ──────────────
# AWS_ACCESS_KEY_ID=
# AWS_ACCESS_SECRET=
# AWS_REGION=
# AWS_BUCKET=
# AWS_BUCKET_URL=https://<bucket>.s3.<region>.amazonaws.com
# AWS_ACL=public-read   # remove if using a bucket policy for public read instead

# ─── CORS (production only) ───────────────────────────────────────────────────
# CLIENT_URL=https://your-nextjs-app.vercel.app

# ─── Import scripts (local dev only) ─────────────────────────────────────────
# ENABLE_RECIPE_IMPORT=true
# STRAPI_URL=http://localhost:1337
# STRAPI_IMPORT_TOKEN=
