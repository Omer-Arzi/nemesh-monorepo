{
  "kind": "collectionType",
  "collectionName": "content_pages",
  "info": {
    "singularName": "content-page",
    "pluralName": "content-pages",
    "displayName": "Content Page",
    "description": "General-purpose CMS pages served at /<slug>"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "content": {
      "type": "blocks",
      "required": true
    },
    "showInFooter": {
      "type": "boolean",
      "default": false
    },
    "footerSection": {
      "type": "string"
    },
    "footerOrder": {
      "type": "integer"
    }
  }
}
